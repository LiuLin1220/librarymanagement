PORT=3001
CORS_ORIGIN=http://localhost:8080

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_PASSWORD_FILE=
DB_NAME=librarymanagement
DB_CONNECTION_LIMIT=10

STATIC_DIRECTORY=
VUE_APP_API_BASE_URL=http://localhost:3001/api

# Optional Docker Compose overrides. With no .env file, WSL defaults to the
# local 12334 HTTP proxy and exposes only http://127.0.0.1:8080.
APP_HOST=127.0.0.1
APP_PORT=8080
MYSQL_IMAGE=mysql:8.4.11
MYSQL_DATABASE=librarymanagement
MYSQL_USER=library_app
BUILD_NETWORK=host
BUILD_HTTP_PROXY=http://127.0.0.1:12334
BUILD_HTTPS_PROXY=http://127.0.0.1:12334
BUILD_NO_PROXY=localhost,127.0.0.1,::1
