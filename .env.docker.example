COMPOSE_PROJECT_NAME=librarymanagement
APP_IMAGE=librarymanagement-app:local
ROLLBACK_IMAGE=librarymanagement-app:rollback
APP_HOST=127.0.0.1
APP_PORT=8080
CORS_ORIGIN=http://localhost:8080

BUILD_NETWORK=default
BUILD_HTTP_PROXY=
BUILD_HTTPS_PROXY=
BUILD_NO_PROXY=localhost,127.0.0.1,::1

MYSQL_IMAGE=mysql:8.4.11
MYSQL_DATABASE=librarymanagement
MYSQL_USER=library_app
DB_CONNECTION_LIMIT=10
