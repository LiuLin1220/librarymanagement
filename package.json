{
  "name": "library-management",
  "version": "0.1.0",
  "description": "图书销售管理系统课程设计",
  "private": true,
  "engines": {
    "node": "^22.0.0",
    "npm": ">=10"
  },
  "scripts": {
    "serve": "vue-cli-service serve",
    "start": "node server/index.js",
    "dev:server": "node --watch server/index.js",
    "build": "vue-cli-service build",
    "lint": "eslint --ext .js,.vue src server test",
    "lint:fix": "eslint --ext .js,.vue src server test --fix",
    "test": "node --test test/server/app.test.js test/server/book-repository.test.js test/server/env.test.js",
    "check": "npm run lint && npm test"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "core-js": "^3.50.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "element-ui": "^2.15.14",
    "express": "^5.2.1",
    "mysql2": "^3.23.2",
    "vue": "2.7.16",
    "vue-router": "^3.6.5"
  },
  "devDependencies": {
    "@babel/eslint-parser": "^7.29.7",
    "@vue/cli-plugin-babel": "^5.0.9",
    "@vue/cli-plugin-eslint": "^5.0.9",
    "@vue/cli-plugin-router": "^5.0.9",
    "@vue/cli-service": "^5.0.9",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "vue-template-compiler": "2.7.16"
  }
}
